<mxfile host="app.diagrams.net"><diagram id="kite-detailed" name="Kite model, detailed"><mxGraphModel dx="1300" dy="2077" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="2077" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="loop-size" value="Sizing loop on kite area S" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=2;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="300" y="404" width="640" height="1479" as="geometry"/></mxCell><mxCell id="loop-bins" value="For each wind bin v_j" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=2;fillColor=none;dashed=1;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="324" y="742" width="610" height="937" as="geometry"/></mxCell><mxCell id="title" value="Soft-kite performance model: detailed flowchart (equation numbers M1–M29 refer to the model doc)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1000" height="28" as="geometry"/></mxCell><mxCell id="in-design" value="&lt;b&gt;Design inputs&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;min&lt;/sub&gt;, z&lt;sub&gt;max&lt;/sub&gt;  (flying heights)&lt;br&gt;P̄&lt;sub&gt;target&lt;/sub&gt; = 30 kW  (mean power)&lt;br&gt;F&lt;sub&gt;max&lt;/sub&gt;  (max. tether force)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=22;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#b58900;" vertex="1" parent="1"><mxGeometry x="360" y="68" width="270" height="92" as="geometry"/></mxCell><mxCell id="in-wind" value="&lt;b&gt;Wind class (wind analysis)&lt;/b&gt;&lt;br&gt;bins v&lt;sub&gt;j&lt;/sub&gt; with probability p&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;at heights up to 500 m&lt;br&gt;one run per wind class" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=22;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#b58900;" vertex="1" parent="1"><mxGeometry x="650" y="68" width="270" height="92" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;A. Geometry, wind and tether (once per run)&lt;/b&gt;&lt;br&gt;r&lt;sub&gt;min&lt;/sub&gt; = z&lt;sub&gt;min&lt;/sub&gt; / sin β&lt;sub&gt;o&lt;/sub&gt;,   r&lt;sub&gt;max&lt;/sub&gt; = z&lt;sub&gt;max&lt;/sub&gt; / sin β&lt;sub&gt;o&lt;/sub&gt;   (M1)&lt;br&gt;Δl = r&lt;sub&gt;max&lt;/sub&gt; − r&lt;sub&gt;min&lt;/sub&gt;,   r̄ = ½ (r&lt;sub&gt;min&lt;/sub&gt; + r&lt;sub&gt;max&lt;/sub&gt;)   (M1)&lt;br&gt;z̄ = ½ sin β&lt;sub&gt;o&lt;/sub&gt; (r&lt;sub&gt;min&lt;/sub&gt; + r&lt;sub&gt;max&lt;/sub&gt;)   (M2)&lt;br&gt;ρ = ρ&lt;sub&gt;0&lt;/sub&gt; exp(−z̄ / H&lt;sub&gt;ρ&lt;/sub&gt;)   (M3)&lt;br&gt;p&lt;sub&gt;j&lt;/sub&gt; at z̄: linear interpolation between data heights   (M4)&lt;br&gt;d&lt;sub&gt;t&lt;/sub&gt; = √(4 F&lt;sub&gt;max&lt;/sub&gt; / (π σ&lt;sub&gt;t&lt;/sub&gt;))   (M5)&lt;br&gt;m&lt;sub&gt;t&lt;/sub&gt; = (π/4) d&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; ρ&lt;sub&gt;t&lt;/sub&gt; r̄ (airborne),   m&lt;sub&gt;t,tot&lt;/sub&gt; = (π/4) d&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; ρ&lt;sub&gt;t&lt;/sub&gt; r&lt;sub&gt;max&lt;/sub&gt;   (M6)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="194" width="560" height="168" as="geometry"/></mxCell><mxCell id="pA" value="&lt;b&gt;Parameters A&lt;/b&gt;&lt;br&gt;β&lt;sub&gt;o&lt;/sub&gt; = 25°  (Schelbergen 2020)&lt;br&gt;ρ&lt;sub&gt;0&lt;/sub&gt; = 1.225 kg/m&lt;sup&gt;3&lt;/sup&gt;, H&lt;sub&gt;ρ&lt;/sub&gt; = 8.55 km  (vd Vlugt 2019)&lt;br&gt;σ&lt;sub&gt;t&lt;/sub&gt; = 7·10&lt;sup&gt;8&lt;/sup&gt; Pa  (Joshi 2024)&lt;br&gt;ρ&lt;sub&gt;t&lt;/sub&gt; = 724 kg/m&lt;sup&gt;3&lt;/sup&gt;  (vd Vlugt 2019)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="194" width="290" height="111" as="geometry"/></mxCell><mxCell id="oA" value="&lt;b&gt;Output → mass &amp;amp; volume budget&lt;/b&gt;&lt;br&gt;tether diameter d&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;tether length r&lt;sub&gt;max&lt;/sub&gt;&lt;br&gt;tether mass m&lt;sub&gt;t,tot&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#5a8f4a;" vertex="1" parent="1"><mxGeometry x="980" y="194" width="300" height="92" as="geometry"/></mxCell><mxCell id="chk" value="Mean power at the largest allowed area S&lt;sub&gt;hi&lt;/sub&gt; ≥ 30 kW?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="470" y="426" width="340" height="60" as="geometry"/></mxCell><mxCell id="stop" value="&lt;b&gt;Stop: F&lt;sub&gt;max&lt;/sub&gt; too low&lt;/b&gt;&lt;br&gt;no kite size reaches the target&lt;br&gt;→ raise F&lt;sub&gt;max&lt;/sub&gt; or lower the target" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="980" y="430" width="300" height="73" as="geometry"/></mxCell><mxCell id="rf" value="&lt;b&gt;Root finder (Brent): trial kite area S&lt;/b&gt;&lt;br&gt;start with S&lt;sub&gt;lo&lt;/sub&gt; and S&lt;sub&gt;hi&lt;/sub&gt;, narrow down until P̄(S) = 30 kW within 0.2 m&lt;sup&gt;2&lt;/sup&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="520" width="560" height="54" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;B. Kite properties for trial S&lt;/b&gt;&lt;br&gt;m = w · S   (wing + control unit),   A = S / 0.78   (M7, M8)&lt;br&gt;C&lt;sub&gt;D&lt;/sub&gt; = C&lt;sub&gt;D,k&lt;/sub&gt; + ¼ d&lt;sub&gt;t&lt;/sub&gt; r̄ C&lt;sub&gt;D,c&lt;/sub&gt; / S   (reel-out and reel-in)   (M9)&lt;br&gt;C&lt;sub&gt;R&lt;/sub&gt; = √(C&lt;sub&gt;L&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + C&lt;sub&gt;D&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;),   G* = C&lt;sub&gt;L&lt;/sub&gt; / C&lt;sub&gt;D&lt;/sub&gt;   (M10)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="608" width="560" height="92" as="geometry"/></mxCell><mxCell id="pB" value="&lt;b&gt;Parameters B&lt;/b&gt;&lt;br&gt;w = 2.0 kg/m&lt;sup&gt;2&lt;/sup&gt;  (Cayon 2026)&lt;br&gt;C&lt;sub&gt;L,o&lt;/sub&gt; = 0.9, C&lt;sub&gt;D,k,o&lt;/sub&gt; = 0.2  (powered)&lt;br&gt;C&lt;sub&gt;L,i&lt;/sub&gt; = 0.2, C&lt;sub&gt;D,k,i&lt;/sub&gt; = 0.1  (depowered)&lt;br&gt;C&lt;sub&gt;D,c&lt;/sub&gt; = 1.1  (Schelbergen 2020)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="608" width="290" height="111" as="geometry"/></mxCell><mxCell id="oB" value="&lt;b&gt;Output → mass &amp;amp; volume budget&lt;/b&gt;&lt;br&gt;projected area S, flat area A&lt;br&gt;airborne mass m" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#5a8f4a;" vertex="1" parent="1"><mxGeometry x="980" y="608" width="300" height="73" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;C1. Reel-out state: geometry   (for β = 25° … 60°, each trial f&lt;sub&gt;o&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;f&lt;sub&gt;o&lt;/sub&gt; from v&lt;sub&gt;min&lt;/sub&gt;/v&lt;sub&gt;w&lt;/sub&gt; to v&lt;sub&gt;max&lt;/sub&gt;/v&lt;sub&gt;w&lt;/sub&gt;;   θ = 90° − β&lt;br&gt;a = cosθ cosφ cosχ − sinφ sinχ,   b = sinθ cosφ   (M11)&lt;br&gt;start: κ = G*&lt;sub&gt;o&lt;/sub&gt;   (massless value, M17)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="764" width="560" height="92" as="geometry"/></mxCell><mxCell id="pC" value="&lt;b&gt;Parameters C&lt;/b&gt;&lt;br&gt;φ&lt;sub&gt;o&lt;/sub&gt; = 13°, χ&lt;sub&gt;o&lt;/sub&gt; = 100°  (Schelbergen 2020)&lt;br&gt;v&lt;sub&gt;min&lt;/sub&gt; = 2 m/s, v&lt;sub&gt;max&lt;/sub&gt; = 10 m/s  (idem)&lt;br&gt;g = 9.81 m/s&lt;sup&gt;2&lt;/sup&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="764" width="290" height="92" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;C2. Gravity iteration&lt;/b&gt;&lt;br&gt;λ = a + √(a&lt;sup&gt;2&lt;/sup&gt; + b&lt;sup&gt;2&lt;/sup&gt; − 1 + κ&lt;sup&gt;2&lt;/sup&gt;(b − f)&lt;sup&gt;2&lt;/sup&gt;)   (M12)&lt;br&gt;v&lt;sub&gt;a&lt;/sub&gt; = v&lt;sub&gt;w&lt;/sub&gt; [b − f,  cosθ cosφ − λ cosχ,  −sinφ − λ sinχ],   |v&lt;sub&gt;a&lt;/sub&gt;| = (b − f)√(1 + κ&lt;sup&gt;2&lt;/sup&gt;) v&lt;sub&gt;w&lt;/sub&gt;   (M13)&lt;br&gt;F&lt;sub&gt;a&lt;/sub&gt; = ½ ρ v&lt;sub&gt;w&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; S C&lt;sub&gt;R&lt;/sub&gt; (1 + κ&lt;sup&gt;2&lt;/sup&gt;)(b − f)&lt;sup&gt;2&lt;/sup&gt;   (M14)&lt;br&gt;F&lt;sub&gt;a,θ&lt;/sub&gt; = −(m + ½ m&lt;sub&gt;t&lt;/sub&gt;) g sinθ,   F&lt;sub&gt;a,r&lt;/sub&gt; = √(F&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; − F&lt;sub&gt;a,θ&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;)   (M15, M16)&lt;br&gt;G&lt;sub&gt;i&lt;/sub&gt; = √((F&lt;sub&gt;a&lt;/sub&gt; |v&lt;sub&gt;a&lt;/sub&gt;| / (F&lt;sub&gt;a&lt;/sub&gt; · v&lt;sub&gt;a&lt;/sub&gt;))&lt;sup&gt;2&lt;/sup&gt; − 1)   (M17)&lt;br&gt;G&lt;sub&gt;i&lt;/sub&gt; ≠ G*:  κ ← κ √(G* / G&lt;sub&gt;i&lt;/sub&gt;) and repeat;   no convergence → no steady flight" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="890" width="560" height="149" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;C3. Tether force and reel-out power&lt;/b&gt;&lt;br&gt;F&lt;sub&gt;t&lt;/sub&gt; = √((F&lt;sub&gt;a,r&lt;/sub&gt; − m g cosθ)&lt;sup&gt;2&lt;/sup&gt; + ¼ sin&lt;sup&gt;2&lt;/sup&gt;θ m&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; g&lt;sup&gt;2&lt;/sup&gt;)   (M18)&lt;br&gt;F&lt;sub&gt;t,g&lt;/sub&gt; = √((√(F&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; − F&lt;sub&gt;t,τ&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;) − cosθ m&lt;sub&gt;t&lt;/sub&gt; g)&lt;sup&gt;2&lt;/sup&gt; + F&lt;sub&gt;t,τ&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;),   F&lt;sub&gt;t,τ&lt;/sub&gt; = ½ sinθ m&lt;sub&gt;t&lt;/sub&gt; g   (M19)&lt;br&gt;P&lt;sub&gt;o&lt;/sub&gt; = F&lt;sub&gt;t,g&lt;/sub&gt; f&lt;sub&gt;o&lt;/sub&gt; v&lt;sub&gt;w&lt;/sub&gt;,   v&lt;sub&gt;o&lt;/sub&gt; = f&lt;sub&gt;o&lt;/sub&gt; v&lt;sub&gt;w&lt;/sub&gt;   (M20)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="1073" width="560" height="92" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;D. Reel-in, stepped in time   (for each set force F&lt;sub&gt;t,i&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;start: r = r&lt;sub&gt;max&lt;/sub&gt;, θ = θ&lt;sub&gt;o&lt;/sub&gt;, φ = 0°, χ = 180°,  Δt = dT Δl / v&lt;sub&gt;w&lt;/sub&gt;  (dT = 0.05 FAST, 0.02 ACCURATE)&lt;br&gt;each step: find f&lt;sub&gt;i&lt;/sub&gt; ∈ [−v&lt;sub&gt;max&lt;/sub&gt;/v&lt;sub&gt;w&lt;/sub&gt;, −v&lt;sub&gt;min&lt;/sub&gt;/v&lt;sub&gt;w&lt;/sub&gt;] with F&lt;sub&gt;t,g&lt;/sub&gt; = F&lt;sub&gt;t,i&lt;/sub&gt;   (C1–C3 with C&lt;sub&gt;L,i&lt;/sub&gt;, C&lt;sub&gt;D,i&lt;/sub&gt;; M21)&lt;br&gt;v&lt;sub&gt;i&lt;/sub&gt; = |f&lt;sub&gt;i&lt;/sub&gt;| v&lt;sub&gt;w&lt;/sub&gt;;   E&lt;sub&gt;i&lt;/sub&gt; += F&lt;sub&gt;t,g&lt;/sub&gt; v&lt;sub&gt;i&lt;/sub&gt; Δt;   t&lt;sub&gt;i&lt;/sub&gt; += Δt&lt;br&gt;r ← r − v&lt;sub&gt;i&lt;/sub&gt; Δt,   θ ← θ − λ v&lt;sub&gt;w&lt;/sub&gt; Δt / r   (kite climbs)&lt;br&gt;until r = r&lt;sub&gt;min&lt;/sub&gt; → t&lt;sub&gt;i&lt;/sub&gt;, E&lt;sub&gt;i&lt;/sub&gt;, θ&lt;sub&gt;end&lt;/sub&gt;;   F&lt;sub&gt;t,g&lt;/sub&gt; &amp;gt; F&lt;sub&gt;max&lt;/sub&gt; → not allowed" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="1199" width="560" height="130" as="geometry"/></mxCell><mxCell id="pD" value="&lt;b&gt;Parameters D&lt;/b&gt;&lt;br&gt;F&lt;sub&gt;t,i&lt;/sub&gt; = 3, 7, 15, 30% of F&lt;sub&gt;max&lt;/sub&gt; (FAST),&lt;br&gt;3, 6, 10, 15, 25, 40% (ACCURATE),&lt;br&gt;at least 300 N  (bounds: Schelbergen 2020)&lt;br&gt;m&lt;sub&gt;t&lt;/sub&gt; and tether drag use the current r" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1199" width="290" height="111" as="geometry"/></mxCell><mxCell id="E" value="&lt;b&gt;E. Transition and cycle power&lt;/b&gt;&lt;br&gt;powered kite, χ = 0°, r = r&lt;sub&gt;min&lt;/sub&gt;, from θ&lt;sub&gt;end&lt;/sub&gt; back to θ&lt;sub&gt;o&lt;/sub&gt;;  t&lt;sub&gt;x&lt;/sub&gt; = Σ r&lt;sub&gt;min&lt;/sub&gt; Δθ / (λ v&lt;sub&gt;w&lt;/sub&gt;)   (M22)&lt;br&gt;f = 0, unless F&lt;sub&gt;t,g&lt;/sub&gt; &amp;gt; F&lt;sub&gt;t,o&lt;/sub&gt;: reel out at F&lt;sub&gt;t,o&lt;/sub&gt;  →  E&lt;sub&gt;x&lt;/sub&gt; += F&lt;sub&gt;t,o&lt;/sub&gt; v Δt,  Δl&lt;sub&gt;x&lt;/sub&gt; += v Δt   (vdV 2019, §2.9)&lt;br&gt;t&lt;sub&gt;o&lt;/sub&gt; = (Δl − Δl&lt;sub&gt;x&lt;/sub&gt;) / v&lt;sub&gt;o&lt;/sub&gt; + v&lt;sub&gt;o&lt;/sub&gt; / a&lt;sub&gt;max&lt;/sub&gt;,   E&lt;sub&gt;o&lt;/sub&gt; = P&lt;sub&gt;o&lt;/sub&gt; (Δl − Δl&lt;sub&gt;x&lt;/sub&gt;) / v&lt;sub&gt;o&lt;/sub&gt;   (M22)&lt;br&gt;P&lt;sub&gt;c&lt;/sub&gt; = (E&lt;sub&gt;o&lt;/sub&gt; + E&lt;sub&gt;x&lt;/sub&gt; − E&lt;sub&gt;i&lt;/sub&gt;) / (t&lt;sub&gt;o&lt;/sub&gt; + t&lt;sub&gt;i&lt;/sub&gt; + t&lt;sub&gt;x&lt;/sub&gt;)   (M23)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="1363" width="560" height="111" as="geometry"/></mxCell><mxCell id="pE" value="&lt;b&gt;Parameters E&lt;/b&gt;&lt;br&gt;a&lt;sub&gt;max&lt;/sub&gt; = 5 m/s&lt;sup&gt;2&lt;/sup&gt;  (Joshi 2024)&lt;br&gt;P&lt;sub&gt;gen,max&lt;/sub&gt;: optional generator limit&lt;br&gt;(default none)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="1363" width="290" height="92" as="geometry"/></mxCell><mxCell id="F" value="&lt;b&gt;F. Operating point for this wind bin&lt;/b&gt;&lt;br&gt;limit F&lt;sub&gt;lim&lt;/sub&gt; = min(F&lt;sub&gt;max&lt;/sub&gt;, P&lt;sub&gt;gen,max&lt;/sub&gt; / v&lt;sub&gt;o&lt;/sub&gt;);  F&lt;sub&gt;t,g,o&lt;/sub&gt; &amp;gt; F&lt;sub&gt;lim&lt;/sub&gt; → depower: C&lt;sub&gt;L&lt;/sub&gt;, C&lt;sub&gt;D,k&lt;/sub&gt; × k so that F&lt;sub&gt;t,g,o&lt;/sub&gt; = F&lt;sub&gt;lim&lt;/sub&gt;,&lt;br&gt;   k ≥ C&lt;sub&gt;L,i&lt;/sub&gt; / C&lt;sub&gt;L,o&lt;/sub&gt;  (Luchsinger 2013, regimes II-III);  not possible → state not allowed   (M24b)&lt;br&gt;keep the f&lt;sub&gt;o&lt;/sub&gt;, F&lt;sub&gt;t,i&lt;/sub&gt; with the highest P&lt;sub&gt;c&lt;/sub&gt;   (M24)&lt;br&gt;limit active → also try β + 3°, keep while P&lt;sub&gt;c&lt;/sub&gt; increases;  no allowed point → β + 3°;  β &amp;gt; 60° → cut-out&lt;br&gt;no steady flight at 25° or P&lt;sub&gt;c&lt;/sub&gt; ≤ 0 → below cut-in, P&lt;sub&gt;c&lt;/sub&gt; = 0&lt;br&gt;store P&lt;sub&gt;c&lt;/sub&gt;(v&lt;sub&gt;j&lt;/sub&gt;), P&lt;sub&gt;o&lt;/sub&gt;, P&lt;sub&gt;i&lt;/sub&gt;, t&lt;sub&gt;o&lt;/sub&gt;, t&lt;sub&gt;i&lt;/sub&gt;, t&lt;sub&gt;x&lt;/sub&gt;, F&lt;sub&gt;t,i&lt;/sub&gt;, β → next wind bin" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="1508" width="560" height="149" as="geometry"/></mxCell><mxCell id="oF" value="&lt;b&gt;Output → electrical design&lt;/b&gt;&lt;br&gt;per wind bin: P&lt;sub&gt;o&lt;/sub&gt;, P&lt;sub&gt;i&lt;/sub&gt;, t&lt;sub&gt;o&lt;/sub&gt;, t&lt;sub&gt;i&lt;/sub&gt;, t&lt;sub&gt;x&lt;/sub&gt;&lt;br&gt;(apply η: P&lt;sub&gt;o&lt;/sub&gt;·η and P&lt;sub&gt;i&lt;/sub&gt;/η)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#5a8f4a;" vertex="1" parent="1"><mxGeometry x="980" y="1508" width="300" height="73" as="geometry"/></mxCell><mxCell id="G" value="&lt;b&gt;G. Mean power over the wind class&lt;/b&gt;&lt;br&gt;P̄(S) = Σ&lt;sub&gt;j&lt;/sub&gt; p&lt;sub&gt;j&lt;/sub&gt; P&lt;sub&gt;c&lt;/sub&gt;(v&lt;sub&gt;j&lt;/sub&gt;)   (M26)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="1713" width="560" height="54" as="geometry"/></mxCell><mxCell id="dec" value="P̄(S) = 30 kW?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="1801" width="280" height="60" as="geometry"/></mxCell><mxCell id="H" value="&lt;b&gt;H. Outputs and metrics for this wind class&lt;/b&gt;&lt;br&gt;v&lt;sub&gt;in&lt;/sub&gt;, v&lt;sub&gt;out&lt;/sub&gt;: limits of operation, refined between the bins by bisection   (M24)&lt;br&gt;P&lt;sub&gt;rated&lt;/sub&gt; = F&lt;sub&gt;max&lt;/sub&gt; v&lt;sub&gt;max&lt;/sub&gt;   (peak reel-out power)   (M25)&lt;br&gt;T&lt;sub&gt;out&lt;/sub&gt; = 8760 × probability of v &amp;lt; v&lt;sub&gt;in&lt;/sub&gt; or v &amp;gt; v&lt;sub&gt;out&lt;/sub&gt;   (M27)&lt;br&gt;σ&lt;sub&gt;P&lt;/sub&gt; / P̄ = √(Σ p&lt;sub&gt;j&lt;/sub&gt; (P&lt;sub&gt;c,j&lt;/sub&gt; − P̄)&lt;sup&gt;2&lt;/sup&gt;) / P̄   (M28)&lt;br&gt;CF = P̄ / P&lt;sub&gt;rated&lt;/sub&gt;   (M29)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="1917" width="560" height="130" as="geometry"/></mxCell><mxCell id="oH" value="&lt;b&gt;Output → trade-off criteria&lt;/b&gt;&lt;br&gt;Power generation: P̄, power curve, CF&lt;br&gt;Stability: σ&lt;sub&gt;P&lt;/sub&gt; / P̄&lt;br&gt;Time out of operation: T&lt;sub&gt;out&lt;/sub&gt;, v&lt;sub&gt;in&lt;/sub&gt;, v&lt;sub&gt;out&lt;/sub&gt;&lt;br&gt;Logistics, cost: S, A, m, d&lt;sub&gt;t&lt;/sub&gt;, r&lt;sub&gt;max&lt;/sub&gt;, m&lt;sub&gt;t,tot&lt;/sub&gt;&lt;br&gt;Safety, community: r&lt;sub&gt;max&lt;/sub&gt;, β" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#5a8f4a;" vertex="1" parent="1"><mxGeometry x="980" y="1917" width="300" height="130" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in-design" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in-wind" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pA" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="oA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="chk" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chk" target="rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rf" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pB" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="oB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pC" target="C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C1" target="C2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C2" target="C3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C3" target="D"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pD" target="D"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D" target="E"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pE" target="E"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="oF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="next f_o, β" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="C1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="338" y="1582.5"/><mxPoint x="338" y="810.0"/></Array></mxGeometry></mxCell><mxCell id="e21" value="all bins done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="G"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="no: new S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="rf"><mxGeometry x="-0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="316" y="1831"/><mxPoint x="316" y="547.0"/></Array></mxGeometry></mxCell><mxCell id="e24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="H"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="H" target="oH"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>