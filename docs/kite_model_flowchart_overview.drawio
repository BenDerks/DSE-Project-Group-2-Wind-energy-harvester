<mxfile host="app.diagrams.net"><diagram id="kite-model" name="Kite model flowchart"><mxGraphModel dx="1000" dy="1200" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Each run sizes the kite area until mean power reaches 30 kW&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="fs" value="Sizing loop: root finder on kite area S" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=none;dashed=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="24" y="296" width="688" height="680" as="geometry"/></mxCell><mxCell id="fw" value="For each wind bin v_j: optimise f_o" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fillColor=none;dashed=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="48" y="432" width="640" height="352" as="geometry"/></mxCell><mxCell id="in1" value="&lt;b&gt;Design inputs&lt;/b&gt;&lt;br&gt;z_min and z_max&lt;br&gt;mean power target 30 kW&lt;br&gt;maximum tether force F_max" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="24" y="56" width="216" height="88" as="geometry"/></mxCell><mxCell id="in2" value="&lt;b&gt;Wind class&lt;/b&gt;&lt;br&gt;probability per wind bin&lt;br&gt;at heights up to 500 m&lt;br&gt;from the wind analysis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="260" y="56" width="216" height="88" as="geometry"/></mxCell><mxCell id="in3" value="&lt;b&gt;Fixed parameters&lt;/b&gt;&lt;br&gt;aero and mass data&lt;br&gt;tether stress, density, drag&lt;br&gt;reel speed and force limits" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="496" y="56" width="216" height="88" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;A. Geometry, wind and tether&lt;/b&gt;&lt;br&gt;r_min, r_max, mean altitude, air density (M1–M3)&lt;br&gt;wind probabilities at mean altitude (M4)&lt;br&gt;tether diameter d_t and mass m_t (M5–M6)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="168" y="176" width="400" height="88" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;B. Kite for trial area S&lt;/b&gt;&lt;br&gt;mass m = w · S and flat area A (M7–M8)&lt;br&gt;C_D and C_R per phase incl. tether drag (M9–M10)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="168" y="336" width="400" height="72" as="geometry"/></mxCell><mxCell id="C" value="&lt;b&gt;C. Reel-out state&lt;/b&gt;&lt;br&gt;gravity iteration (M11–M19)&lt;br&gt;reel-out power P_o (M20)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="64" y="472" width="280" height="72" as="geometry"/></mxCell><mxCell id="D" value="&lt;b&gt;D. Reel-in state&lt;/b&gt;&lt;br&gt;time-stepped, optimised force (M21)&lt;br&gt;reel-in power P_i (M20)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="392" y="472" width="280" height="72" as="geometry"/></mxCell><mxCell id="E" value="&lt;b&gt;E. Cycle&lt;/b&gt;&lt;br&gt;t_o, t_i and transition t_x (M22)&lt;br&gt;cycle power P_c (M23)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="228" y="576" width="280" height="72" as="geometry"/></mxCell><mxCell id="F" value="&lt;b&gt;F. Operating point&lt;/b&gt;&lt;br&gt;maximise P_c over f_o and F_t,i (M24)&lt;br&gt;limits F_max and v_max; elevation up to 60°&lt;br&gt;P_c = 0 below cut-in and above cut-out" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="168" y="680" width="400" height="88" as="geometry"/></mxCell><mxCell id="G" value="&lt;b&gt;G. Mean power&lt;/b&gt;&lt;br&gt;sum of p_j · P_c over the wind bins (M26)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="168" y="808" width="400" height="56" as="geometry"/></mxCell><mxCell id="dec" value="mean = 30 kW?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="278" y="888" width="180" height="72" as="geometry"/></mxCell><mxCell id="H" value="&lt;b&gt;H. Outputs per wind class&lt;/b&gt;&lt;br&gt;S, A, m, d_t, r_max, m_t (M5–M8)&lt;br&gt;cut-in, rated and cut-out wind; P_rated; CF (M24, M25, M29)&lt;br&gt;power curve (P_o, P_i, t_o, t_i); T_out; σ_P / mean (M27–M28)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="108" y="1008" width="520" height="88" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.18;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in1" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in2" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.82;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in3" target="A"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="D"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogona